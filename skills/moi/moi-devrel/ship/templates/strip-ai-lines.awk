# strip-ai-lines.awk: take one commit message on standard input, print it without the lines that name
# an AI tool as co-author or generator. Used as the message filter of the rewrite in
# references/rewrite-history.md, on commits of an open pull request only and after the operator's yes.
#
# Removes: a co-author trailer whose line names Claude, Anthropic, Copilot, ChatGPT, OpenAI, Codex,
# Gemini or Cursor, and a "generated with" or "generated by" footer line that names one of them.
# Keeps: every other line, including a co-author trailer for a human being. A person whose name
# contains one of those words would lose their trailer too, so read the range-diff after the rewrite.
# Also removes the blank line a removal leaves behind, and any blank lines at the end of the message.
# Case does not matter. Nothing else in the message changes.
#
# Usage:   export AWKFILE="$SKILLS/moi-devrel/ship/templates/strip-ai-lines.awk"
#          git filter-branch -f --msg-filter 'awk -f "$AWKFILE"' -- "$BASE"..HEAD
#          Test it on one message first:  git log -1 --format=%B | awk -f "$AWKFILE"
# Portable awk: runs on the awk that ships with macOS and with Linux.
{ line[NR] = $0 }
END {
    n = 0
    gap = 0
    for (i = 1; i <= NR; i++) {
        low = tolower(line[i])
        if (low ~ /^[ \t]*co-authored-by:.*(claude|anthropic|copilot|chatgpt|openai|codex|gemini|cursor)/) { gap = 1; continue }  # slop-lint:ignore
        if (low ~ /generated[ \t]+(with|by).*(claude|anthropic|copilot|chatgpt|openai|codex|gemini|cursor)/) { gap = 1; continue }
        if (gap && line[i] ~ /^[ \t]*$/ && n > 0 && keep[n] ~ /^[ \t]*$/) { continue }
        gap = 0
        keep[++n] = line[i]
    }
    while (n > 0 && keep[n] ~ /^[ \t]*$/) n--
    for (i = 1; i <= n; i++) print keep[i]
}
